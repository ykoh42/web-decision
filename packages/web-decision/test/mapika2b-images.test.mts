test('Mapika preserves Pillow pixels for packed Adam7 grayscale and transparent palette PNGs', async (t) => {
  const magickWasm = await readFile(new URL(import.meta.resolve('@imagemagick/magick-wasm/magick.wasm')));
  for (const [name, base64, expected] of adam7) {
    await t.test(name, async () => {
      const data = Buffer.from(base64, 'base64');
      const result = await preprocessMapika2bImage(image(data), {magickWasm});
      assert.deepEqual(result.imageGridThw, [1, 14, 22]);
      assert.equal(pixelDigest(result.pixelValues), expected);
    });
  }
});

test('Mapika loads JPEG bytes without EXIF orientation rewriting', async () => {
  const wasm = await readFile(new URL(import.meta.resolve('@jsquash/jpeg/codec/dec/mozjpeg_dec.wasm')));
  await initJpeg(new WebAssembly.Module(wasm));
  const data = await readFile(new URL('rgb-exif6.jpg', fixtures));

  // The pinned upstream checks the declared format but determines the decoder from the bytes.
  const result = await preprocessMapika2bImage(image(data, 'png'));
  assert.deepEqual(result.decodedSize, {width: 64, height: 32});
  assert.deepEqual(result.imageGridThw, [1, 12, 24]);
  assert.equal(pixelDigest(result.pixelValues), 'ac4ddf76439871a68db0f2f7eb8ab29847f1ef883fd14ee0a5f4c58d6b1475bb');
});

test('Mapika loads CMYK JPEG with Pillow-compatible RGB colors', async () => {
  const magickWasm = await readFile(new URL(import.meta.resolve('@imagemagick/magick-wasm/magick.wasm')));
  const data = await readFile(new URL('cmyk.jpg', fixtures));

  const result = await preprocessMapika2bImage(image(data, 'jpeg'), {magickWasm});

  assert.deepEqual(result.decodedSize, {width: 16, height: 8});
  assert.equal(pixelDigest(result.pixelValues), 'f8e187831fe71207a6d878c188ec95a51b81da84f495d3e12a7472f9e9cd5da9');
});

test('Mapika enforces the upstream aspect ratio and honors cancellation', async () => {
  const input = image(gradientPng(201, 1));
  await assert.rejects(preprocessMapika2bImage(input), /aspect ratio must be at most 200/);

  const reason = new Error('request cancelled');
  await assert.rejects(preprocessMapika2bImage(input, {signal: AbortSignal.abort(reason)}), reason);
});
