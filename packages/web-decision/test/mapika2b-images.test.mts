const fixtures = new URL('./fixtures/kanana-image/', import.meta.url);

function gradientPng(width: number, height: number): Uint8Array {
  const data = new Uint8Array(width * height * 3);
  for (let y = 0, pixel = 0; y < height; y++) {
    for (let x = 0; x < width; x++) {
      data[pixel++] = x * 31 + y * 13;
      data[pixel++] = x * 9 + y * 127;
      data[pixel++] = x * y * 17 + x * 5 + y * 3;
    }
  }
  return encodePng({width, height, data, channels: 3});
}

function pixelDigest(pixels: Float32Array): string {
  return createHash('sha256')
    .update(Buffer.from(pixels.buffer, pixels.byteOffset, pixels.byteLength))
    .digest('hex');
}

function image(data: Uint8Array, format: Mapika2bImageAsset['format'] = 'png'): Mapika2bImageAsset {
  return {reference: 'photo', format, data};
}

test('Mapika maps the recorded upstream BF16 image fixture to its exact Qwen2VL pixel input', async () => {
  const data = Buffer.from(
    'iVBORw0KGgoAAAANSUhEUgAAAFQAAAA4CAIAAADsP0i3AAAAV0lEQVR4nO3PMQ0AAAzDsPInvcHoUUsBEOeS2foH8PDw8PDw8PDw8PDw8PDw8PDw8PDw8PDw8MP1D+Dh4eHh4eHh4eHh4eHh4eHh4eHh4eHh4eGH6x8UezyMTq85he2pAAAAAElFTkSuQmCC',
    'base64'
  );

  const result = await preprocessMapika2bImage(image(data));

  assert.deepEqual(result.decodedSize, {width: 84, height: 56});
  assert.deepEqual(result.processedSize, {width: 320, height: 224});
  assert.deepEqual(result.imageGridThw, [1, 14, 20]);
  assert.deepEqual(result.pixelShape, [280, 1_536]);
  assert.equal(pixelDigest(result.pixelValues), '79013e780e31e583293f6f2f5fd0dfbbeb0f509a52ed4d050447dffeeedbd504');
});

