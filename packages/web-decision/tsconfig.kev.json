{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "files": [
    "src/kev.ts",
    "src/kev-loader.ts",
    "src/kev06/upstream-source.mts",
    "src/runtime/tvm-source.d.ts",
    "src/deberta/contract.mts",
    "src/deberta/model.mts",
    "src/deberta/packed-readback.mts",
    "src/deberta/validate.mts",
    "test/kev-loader.test.mts",
    "test/kev06-upstream-source.test.mts"
  ]
}
