{
  "name": "web-decision",
  "version": "0.5.0",
  "description": "Curated browser-local decision models running on TVM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/curated/public-index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/curated/public-index.d.ts",
  "files": [
    "dist",
    "src/curated/public-index.d.ts",
    "src/curated/public-types.d.ts",
    "src/curated/public-model-id.generated.d.ts",
    "src/curated/strands-qwen35-candidate-types.d.ts",
    "src/kanana/json-float.d.ts",
    "README.md",
    "LICENSE",
    "KANANA-NOTICE",
    "KANANA-OPEN-LICENSE.txt",
    "QWEN-APACHE-LICENSE.txt",
    "STRANDS-QWEN35-LICENSE.md",
    "STRANDS-QWEN35-NOTICE",
    "KEV06-NOTICE",
    "KEV-NOTICE",
    "EMSCRIPTEN-LICENSE",
    "ROLLDOWN-LICENSE",
    "ROLLDOWN-THIRD-PARTY-LICENSE",
    "VITE-LICENSE.md",
    "TVM-LICENSE",
    "TVM-NOTICE",
    "assets/kanana/manifest.json",
    "assets/kanana/kanana-text-model.wasm",
    "assets/kanana/text-weight-manifest.json",
    "assets/kanana/kanana-vision-model.wasm",
    "assets/kanana/vision-weight-manifest.json",
    "assets/kanana/safetensors-range-manifest.json",
    "assets/qwen35/manifest.json",
    "assets/qwen35/pinned-word-assets-manifest.json",
    "assets/qwen35/source-range-inventory.json",
    "assets/qwen35/r19/manifest.json",
    "assets/qwen35/r19/fixture.json",
    "assets/qwen35/r19/weight-bindings.json",
    "assets/qwen35/r19/qwen35-text-pointer.webgpu.wasm",
    "assets/qwen35/vision/fixture.json",
    "assets/qwen35/vision/weight-bindings.json",
    "assets/qwen35/vision/qwen35-dynamic-vision.webgpu.wasm"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "check:catalog": "node --import tsx scripts/build-model-catalog.mts --check",
    "typecheck:curated": "tsc --project tsconfig.curated.json",
    "typecheck:strands-qwen35": "tsc --project tsconfig.strands-qwen35.json",
    "typecheck:mapika2b": "tsc --project tsconfig.mapika2b.json",
    "typecheck:kev": "tsc --project tsconfig.kev.json",
    "test": "node --import tsx ../../scripts/kanana/run-node-tests.mts",
    "test:kanana-core": "node --import tsx ../../scripts/kanana/run-node-tests.mts --core",
    "test:kanana-runtime": "tsc --project tsconfig.kanana-runtime.json && tsc --project tsconfig.kanana-runtime-tests.json && node --import tsx --test test/kanana-tvm-runtime.test.mts",
    "typecheck:kanana-core": "tsc --project tsconfig.kanana-core.json",
    "typecheck:kanana-runtime": "tsc --project tsconfig.kanana-runtime.json",
    "typecheck:kanana-runtime-tests": "tsc --project tsconfig.kanana-runtime-tests.json",
    "test:coverage": "c8 --all --src src --include=src/** --extension .js --extension .cjs --extension .mjs --extension .ts --extension .tsx --extension .jsx --extension .mts --extension .cts --exclude-after-remap --exclude=src/*.d.ts --exclude=src/**/*.d.ts --exclude=src/*.d.mts --exclude=src/**/*.d.mts --exclude=src/*.d.cts --exclude=src/**/*.d.cts --check-coverage --lines 85 --branches 80 --reporter=text --reporter=json-summary node --import tsx ../../scripts/kanana/run-node-tests.mts && node --import tsx ../../scripts/ci/check-uncovered.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0"
  },
  "devDependencies": {
    "@imagemagick/magick-wasm": "0.0.46",
    "@jsquash/jpeg": "1.6.0",
    "c8": "12.0.0",
    "fast-png": "8.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "license": "Apache-2.0"
}
