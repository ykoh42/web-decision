{
  "name": "web-decision",
  "version": "0.0.0-preview.35",
  "description": "Curated browser-local decision models running on TVM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/curated/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/curated/index.d.ts",
  "files": [
    "dist",
    "src/curated/index.d.ts",
    "src/curated/types.d.ts",
    "src/catalog/types.generated.d.ts",
    "assets/kev06-stable/manifest.json",
    "assets/kev06-stable/PROVENANCE.md",
    "assets/kev06-stable/notices",
    "assets/experimental-kev-upstream/notices",
    "README.md",
    "LICENSE",
    "KEV06-NOTICE",
    "KEV-NOTICE",
    "EMSCRIPTEN-LICENSE",
    "ROLLDOWN-LICENSE",
    "ROLLDOWN-THIRD-PARTY-LICENSE",
    "VITE-LICENSE.md",
    "TVM-LICENSE",
    "TVM-NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config vite.config.ts",
    "check:catalog": "node --import tsx scripts/build-model-catalog.mts --check",
    "typecheck:curated": "tsc --project tsconfig.curated.json",
    "typecheck:kev": "tsc --project tsconfig.kev.json",
    "test": "node --import tsx ../../scripts/kanana/run-node-tests.mts",
    "test:kanana-core": "node --import tsx ../../scripts/kanana/run-node-tests.mts --core",
    "test:kanana-runtime": "pnpm run typecheck:kanana-runtime && node --test test/kanana-tvm-runtime.test.mjs",
    "typecheck:kanana-core": "tsc --project tsconfig.kanana-core.json",
    "typecheck:kanana-runtime": "tsc --project tsconfig.kanana-runtime.json",
    "test:coverage": "c8 --all --src src --include=src/** --extension .js --extension .cjs --extension .mjs --extension .ts --extension .tsx --extension .jsx --extension .mts --extension .cts --exclude-after-remap --exclude=src/*.d.ts --exclude=src/**/*.d.ts --exclude=src/*.d.mts --exclude=src/**/*.d.mts --exclude=src/*.d.cts --exclude=src/**/*.d.cts --exclude=src/tinydecide/corrections.js --check-coverage --lines 85 --branches 80 --reporter=text --reporter=json-summary node --import tsx ../../scripts/kanana/run-node-tests.mts && node --import tsx ../../scripts/ci/check-uncovered.ts",
    "build:kev-preview": "vite build --config vite.kev-preview.config.mjs",
    "build:tinydecide-preview": "vite build --config vite.tinydecide-preview.config.mjs",
    "build:kev-deberta-preview": "vite build --config vite.kev-deberta-preview.config.mjs",
    "build:kev-deberta-reflexes-preview": "vite build --config vite.kev-deberta-reflexes-preview.config.mjs"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0"
  },
  "devDependencies": {
    "@imagemagick/magick-wasm": "0.0.46",
    "@jsquash/jpeg": "1.6.0",
    "c8": "12.0.0",
    "fast-png": "8.0.0",
    "onnxruntime-web": "1.31.1",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "license": "Apache-2.0"
}
