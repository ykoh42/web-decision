+ * under the License.
+ */
+const assert = require("assert");
+
+jest.mock("../../src/compact", () => ({}));
+const { Instance } = require("../../src/runtime");
+
+function createCallStack() {
+  let nextOffset = 0;
+  return {
+    allocRawBytes: jest.fn((size) => {
+      const offset = nextOffset;
+      nextOffset += size;
+      return offset;
+    }),
+    storeI32: jest.fn(),
+    storeRawBytes: jest.fn(),
+    commitToWasmMemory: jest.fn(),
+    ptrFromOffset: jest.fn((offset) => offset),
+  };
+}
+
+function createRuntimeDouble(loadI64, scopeEndFailure) {
+  const callStack = createCallStack();
+  const raisedErrors = [];
+  const storedBytes = [];
+  let scopeDepth = 0;
+  const memory = {
+    loadI32: jest.fn(() => 1), // TVMFFIInt
+    loadI64,
+  };
+  const lib = {
+    memory,
+    exports: {
+      TVMFFIErrorSetRaisedFromCStr: jest.fn((kind, message) => {
+        raisedErrors.push([kind, message]);
+      }),
+    },
+    getOrAllocCallStack: jest.fn(() => callStack),
+    recycleCallStack: jest.fn(),
+    checkCall: jest.fn(),
+  };
+  const ctx = {
+    beginScope: jest.fn(() => {
+      scopeDepth += 1;
+    }),
+    endScope: jest.fn(() => {
+      scopeDepth -= 1;
+      if (scopeEndFailure) throw scopeEndFailure;
+    }),
+    get scopeDepth() {
+      return scopeDepth;
+    },
+  };
+  const runtime = Object.create(Instance.prototype);
+  callStack.storeRawBytes.mockImplementation((offset, bytes) => {
+    storedBytes.push([offset, bytes]);
+  });
+  Object.assign(runtime, {
+    lib,
+    memory,
+    ctx,
+    exports: {
+      TVMFFIFunctionCall: jest.fn(() => 0),
+    },
+    asyncifyHandler: {isNormalStackState: () => true},
+  });
+  return {runtime, callStack, lib, ctx, raisedErrors, storedBytes};
+}
+
+test("callback decode errors are reported and close their scope", () => {
+  const failure = new Error("Cannot represent int64 value as a JavaScript number");
+  const {runtime, lib, ctx, raisedErrors} = createRuntimeDouble(() => {
+    throw failure;
+  });
+  let callbackCalled = false;
+  const safeCall = runtime.wrapJSFuncAsSafeCallType(() => {
+    callbackCalled = true;
+  });
+
+  const status = safeCall(1, 128, 1, 256);
+
+  assert.strictEqual(status, -1);
+  assert.strictEqual(callbackCalled, false);
+  assert.strictEqual(ctx.scopeDepth, 0);
+  assert.strictEqual(ctx.endScope.mock.calls.length, 1);
+  assert.strictEqual(lib.recycleCallStack.mock.calls.length, 1);
+  assert.strictEqual(raisedErrors.length, 1);
+});
+
+test("callback decode errors survive scope disposer failures", () => {
+  const failure = new Error("Cannot represent int64 value as a JavaScript number");
+  const cleanupFailure = new Error("scope disposer failed");
+  const {runtime, lib, ctx, raisedErrors, storedBytes} = createRuntimeDouble(
+    () => {
+      throw failure;
+    },
+    cleanupFailure
+  );
+  const safeCall = runtime.wrapJSFuncAsSafeCallType(() => {});
+
+  const status = safeCall(1, 128, 1, 256);
+
+  assert.strictEqual(status, -1);
+  assert.strictEqual(ctx.scopeDepth, 0);
+  assert.strictEqual(lib.recycleCallStack.mock.calls.length, 1);
+  assert.strictEqual(raisedErrors.length, 1);
+  const errorMessage = Buffer.from(storedBytes[1][1]).toString().replace(/\0$/, "");
+  assert.strictEqual(
+    errorMessage,
+    "Cannot represent int64 value as a JavaScript number " +
+      "(scope cleanup failed: scope disposer failed)"
+  );
+});
+
+test("packed return decode errors recycle their call stack", () => {
+  const failure = new Error("Cannot represent int64 value as a JavaScript number");
+  const {runtime, lib} = createRuntimeDouble(() => {
+    throw failure;
+  });
+  const packedFunc = runtime.makePackedFunc(1);
+
+  assert.throws(
+    () => packedFunc(),
+    /Cannot represent int64 value as a JavaScript number/
+  );
+  assert.strictEqual(lib.recycleCallStack.mock.calls.length, 1);
+});
