 const { CachedCallStack, Memory } = require("../../src/memory");
 
+test("loadI64 reads values across the signed 32-bit boundary", () => {
+  const wasmMemory = new WebAssembly.Memory({ initial: 1 });
+  const memory = new Memory(wasmMemory);
+  const words = new Uint32Array(wasmMemory.buffer);
+
+  words.set([0x80000000, 0], 2);
+  expect(memory.loadI64(8)).toBe(0x80000000);
+
+  words.set([0x76543210, 1], 2);
+  expect(memory.loadI64(8)).toBe(0x176543210);
+
+  words.set([0x80000000, 0xffffffff], 2);
+  expect(memory.loadI64(8)).toBe(-0x80000000);
+  words.set([0xffffffff, 0xffffffff], 2);
+  expect(memory.loadI64(8)).toBe(-1);
+
+  words.set([0xffffffff, 0x001fffff], 2);
+  expect(memory.loadI64(8)).toBe(Number.MAX_SAFE_INTEGER);
+  words.set([1, 0xffe00000], 2);
+  expect(memory.loadI64(8)).toBe(-Number.MAX_SAFE_INTEGER);
+});
+
+test("loadI64 rejects values outside JavaScript's safe integer range", () => {
+  const wasmMemory = new WebAssembly.Memory({ initial: 1 });
+  const memory = new Memory(wasmMemory);
+  const words = new Uint32Array(wasmMemory.buffer);
+
+  words.set([0, 0x00200000], 2);
+  expect(() => memory.loadI64(8)).toThrow("Cannot represent int64 value");
+  words.set([0, 0xffe00000], 2);
+  expect(() => memory.loadI64(8)).toThrow("Cannot represent int64 value");
+});
+
