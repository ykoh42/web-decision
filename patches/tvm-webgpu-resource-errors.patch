+ * under the License.
+ */
+const { WebGPUContext, WebGPUResourceError } = require("../../src/webgpu");
+
+global.GPUBufferUsage = {
+  COPY_SRC: 1 << 0,
+  COPY_DST: 1 << 1,
+  STORAGE: 1 << 2,
+};
+
+test("sync preserves a GPU buffer allocation failure without destroying the device", async () => {
+  const outOfMemoryError = Object.assign(new Error("allocation failed"), {
+    name: "GPUOutOfMemoryError",
+  });
+  const scopeErrors = [null, null, outOfMemoryError];
+  const device = {
+    queue: {
+      submit: jest.fn(),
+      onSubmittedWorkDone: jest.fn(() => Promise.resolve()),
+    },
+    pushErrorScope: jest.fn(),
+    popErrorScope: jest.fn(() => {
+      const error = scopeErrors.shift();
+      return Promise.resolve(error === undefined ? null : error);
+    }),
+    createBuffer: jest.fn(({ size }) => ({ size, destroy: jest.fn() })),
+    destroy: jest.fn(),
+  };
+  const context = new WebGPUContext({}, device);
+  const allocate = context.getDeviceAPI("deviceAllocDataSpace");
+
+  allocate(1024);
+
+  let caught;
+  try {
+    await context.sync();
+  } catch (error) {
+    caught = error;
+  }
+
+  expect(caught).toBeInstanceOf(WebGPUResourceError);
+  expect(caught.code).toBe("GPU_OUT_OF_MEMORY");
+  expect(caught.cause).toBe(outOfMemoryError);
+  expect(caught.errorScope).toBe("out-of-memory");
+  expect(caught.size).toBe(1024);
+  expect(caught.message).toContain("out-of-memory");
+  expect(device.destroy).not.toHaveBeenCalled();
+  await expect(context.sync()).rejects.toBe(caught);
+});

