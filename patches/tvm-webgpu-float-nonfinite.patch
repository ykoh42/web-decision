diff --git a/src/backend/webgpu/codegen/codegen_webgpu.cc b/src/backend/webgpu/codegen/codegen_webgpu.cc
--- a/src/backend/webgpu/codegen/codegen_webgpu.cc
+++ b/src/backend/webgpu/codegen/codegen_webgpu.cc
@@ -32,6 +32,7 @@
 #include <tvm/tirx/transform.h>
 
 #include <algorithm>
+#include <cmath>
 #include <cstdint>
 #include <limits>
 #include <optional>
@@ -581,17 +582,35 @@
 }
 
 void CodeGenWebGPU::Dispatch_(const FloatImmNode* op, std::ostream& os) {  // NOLINT(*)
+  const int bits = op->ty.as_or_throw<PrimType>().bits();
+  if (std::isinf(op->value) || std::isnan(op->value)) {
+    const bool negative = std::signbit(op->value);
+    const char* value_bits = std::isnan(op->value)
+                                 ? (negative ? "0xffc00000u" : "0x7fc00000u")
+                                 : (negative ? "0xff800000u" : "0x7f800000u");
+    const std::string runtime_bits = std::string(value_bits) + " ^ (threadIdx.x & 0u)";
+    if (bits == 32) {
+      os << "bitcast<f32>(" << runtime_bits << ")";
+    } else if (bits == 16) {
+      enable_fp16_ = true;
+      os << "f16(bitcast<f32>(" << runtime_bits << "))";
+    } else {
+      TVM_FFI_THROW(InternalError) << "Unsupported floating point bits " << bits;
+    }
+    return;
+  }
+
   std::ostringstream temp;
   temp << std::scientific << op->value;
-  if (op->ty.as_or_throw<PrimType>().bits() == 32) {
+  if (bits == 32) {
     temp << 'f';
-  } else if (op->ty.as_or_throw<PrimType>().bits() == 16) {
+  } else if (bits == 16) {
     // Using f16 requires enable directive
     enable_fp16_ = true;
     temp << 'h';
   } else {
     TVM_FFI_THROW(InternalError) << "Unsupported floating point bits "
-                                 << op->ty.as_or_throw<PrimType>().bits();
+                                 << bits;
   }
   MarkConst(temp.str());
   os << temp.str();
