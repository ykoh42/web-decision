{
  "name": "web-decision-release-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "oxlint . --max-warnings=2",
    "format": "oxfmt \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}\"",
    "check:quality": "pnpm run format:check && pnpm run lint && pnpm run test:quality:complexity && pnpm run test:quality:package && pnpm run test:quality:coverage && pnpm run test:quality:release && pnpm run test:quality:provenance && node --import tsx scripts/ci/check_cognitive_complexity.mts && pnpm --filter web-decision check:catalog && pnpm --filter web-decision typecheck:curated && pnpm --filter web-decision typecheck:kev && pnpm --filter web-decision typecheck:strands-qwen35 && tsc --project tests/browser/tsconfig.curated.json && tsc --project tsconfig.tools.json",
    "test:quality:complexity": "node --import tsx --test scripts/ci/test_cognitive_complexity.mts scripts/ci/test_cognitive_complexity_completion.mts",
    "test:quality:package": "node --import tsx --test scripts/ci/asset-key.test.ts scripts/fetch-model.test.ts",
    "test:quality:coverage": "node --import tsx --test scripts/ci/coverage-groups.test.ts scripts/ci/uncovered-files.test.ts",
    "test:release:0.4.0": "pnpm test",
    "test:release:0.5.0": "pnpm test",
    "test:browser:kev06": "pnpm exec playwright test --config=playwright.config.ts tests/browser/kev06-real-webgpu.spec.ts",
    "test:browser:kanana-image": "pnpm exec playwright test --config=playwright.config.ts tests/browser/kanana-image-processing.spec.ts",
    "test:browser:kev06:default-source": "pnpm build:package && npm ci --prefix examples/basic --offline --ignore-scripts --no-audit --no-fund && WEB_DECISION_REAL_GPU=1 WEB_DECISION_BROWSER_NAME=chromium WEB_DECISION_KEV06_DEFAULT_GPU=1 WEB_DECISION_INSTALLED_BUNDLE=examples/basic/node_modules/web-decision/dist/index.js pnpm exec playwright test --config=playwright.config.ts tests/browser/kev06-default-source-real-webgpu.spec.ts",
    "test:browser:kev-upstream-provider": "pnpm build:package && node --import tsx tests/run-kev-upstream-provider.mts",
    "test:types:0.4.0": "node --import tsx scripts/ci/check-release-types.mts 0.4.0",
    "test:types:0.5.0": "node --import tsx scripts/ci/check-release-types.mts 0.5.0",
    "test:types:current": "node --import tsx scripts/ci/check-release-types.mts --current",
    "build:release:0.4.0": "pnpm build:package",
    "pack:release:0.4.0": "npm pack --ignore-scripts ./packages/web-decision",
    "build:release:0.5.0": "pnpm build:package",
    "pack:release:0.5.0": "npm pack --ignore-scripts ./packages/web-decision",
    "test": "pnpm --filter web-decision test",
    "test:package": "pnpm --filter web-decision test",
    "test:package:qwen35-candidate": "node --import tsx --test scripts/strands/qwen35/build_candidate_package.test.mts",
    "build:package": "pnpm --filter web-decision build",
    "test:coverage": "pnpm --filter web-decision test:coverage",
    "check:package": "tsx scripts/ci/check-package.ts",
    "verify:package": "pnpm build:package && pnpm check:package",
    "test:example": "node --import tsx scripts/ci/check-example.mts",
    "test:browser:strands-qwen2": "pnpm exec playwright test --config=playwright.config.ts tests/browser/strands-qwen2-real-webgpu.spec.ts",
    "typecheck": "tsc --project tsconfig.strict.json && pnpm --filter web-decision typecheck:mapika2b && tsc --project tests/browser/tsconfig.mapika2b.json",
    "test:typescript-policy": "node --import tsx --test scripts/ci/typescript-policy.test.mts scripts/ci/tvm-boundary.test.mts",
    "check:javascript-policy": "node --import tsx scripts/ci/check-typescript-policy.mts",
    "check:model-provenance": "node --import tsx scripts/ci/check-model-provenance.mts",
    "check:model-provenance:main": "node --import tsx scripts/ci/check-model-provenance.mts --allow-pending",
    "check:typescript": "pnpm run typecheck && pnpm run test:typescript-policy && pnpm run check:javascript-policy",
    "check:typescript:complete": "pnpm run typecheck && pnpm run test:typescript-policy && node --import tsx scripts/ci/check-typescript-policy.mts --require-complete",
    "test:quality:release": "node --import tsx --test scripts/release/verify-release-evidence.test.ts scripts/release/kanana-current-evidence-commit.test.mts scripts/release/tvm-build-evidence.test.ts scripts/release/runtime-build.test.ts scripts/release/qwen35-deferred-gates.test.mts scripts/release/strands-qwen35-release-evidence.test.ts scripts/release/mapika-release-evidence.test.mts scripts/release/strands-gemma4-v2-release-evidence.test.mts scripts/release/strands-gemma4-v2-split-evidence.test.mts scripts/release/strands-gemma4-v2-split-source.test.mts scripts/release/strands-gemma4-v2-pending-diagnostic.test.mts scripts/release/strands-gemma4-v2-conformance.test.mts tests/browser/kev06-release-evidence.test.ts",
    "test:quality:provenance": "node --import tsx --test scripts/ci/model-provenance.test.ts",
    "check:complexity:complete": "node --import tsx scripts/ci/check_cognitive_complexity.mts && node --import tsx scripts/ci/check_cognitive_complexity_completion.mts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.65.0",
    "@types/node": "20.19.43",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "parse5": "8.1.0",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "description": "`web-decision` is a browser JavaScript library for running decision models locally.",
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykoh42/web-decision.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ykoh42/web-decision/issues"
  },
  "homepage": "https://github.com/ykoh42/web-decision#readme"
}
