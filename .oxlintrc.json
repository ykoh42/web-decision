{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-sonarjs"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "overrides": [
    {
      "files": ["packages/web-decision/src/**/*.{js,mjs}", "packages/web-decision/test/**/*.mjs"],
      "rules": {
        // `new Array(length)` is used for validated, intentional model-buffer preallocation.
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": ["packages/web-decision/src/pinned-text-loader.ts"],
      "rules": {
        // Preserve the existing validated model-buffer preallocation semantics.
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": ["packages/web-decision/src/tinydecide/engine.js"],
      "rules": {
        // Preserve the upstream engine's pinned bytes, including unused reference helpers.
        "no-unused-vars": "off"
      }
    }
  ]
}
