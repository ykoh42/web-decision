{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-sonarjs"],
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "releases/web-decision-0.1.0/**",
    "releases/web-decision-0.2.0/**",
    "releases/web-decision-0.3.0/build/**",
    "releases/web-decision-0.3.0/package/**",
    "releases/web-decision-0.3.0/model-assets/**",
    "releases/web-decision-0.3.0/verification/**",
    "releases/web-decision-0.3.0/source/overlay/.toolchains/**",
    "node_modules/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "overrides": [
    {
      "files": ["packages/web-decision/src/**/*.{js,mjs}", "packages/web-decision/test/**/*.mjs"],
      "rules": {
        // `new Array(length)` is used for validated, intentional model-buffer preallocation.
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": ["packages/web-decision/src/tinydecide/engine.js"],
      "rules": {
        // Preserve the upstream engine's pinned bytes, including unused reference helpers.
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["releases/web-decision-0.3.0/source/overlay/packages/web-decision/src/**/*.{js,mjs}"],
      "rules": {
        // The pinned release uses new Array(length) for validated, intentional preallocation.
        "unicorn/no-new-array": "off"
      }
    },
    {
      "files": ["releases/web-decision-*/source/overlay/packages/web-decision/src/**/*.{js,mjs}"],
      "rules": {
        // Two existing release-source functions exceed this threshold; the lint script fails if more do.
        "sonarjs/cognitive-complexity": ["warn", 15]
      }
    }
  ]
}
