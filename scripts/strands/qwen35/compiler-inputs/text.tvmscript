batch_dim = TypeVar("batch_dim")
channels = TypeVar("channels")
sequence_dim = TypeVar("sequence_dim")
rows = TypeVar("rows")
width = TypeVar("width")
chunks = TypeVar("chunks")
options = TypeVar("options")
size = TypeVar("size")
s0 = TypeVar("s0")
s22 = TypeVar("s22")
s86 = TypeVar("s86")
@I.ir_module
class Module:
    @T.prim_func(s_tir=True)
    def qwen35_causal_conv_silu_bf16_boundaries(input: T.Buffer((batch_dim, channels, sequence_dim), "float32"), weight: T.Buffer((channels, 4), "float32"), bias: T.Buffer((channels,), "float32"), output: T.Buffer((batch_dim, channels, sequence_dim), "float32")):
        T.func_attr({"global_symbol": "causal_conv_silu", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_channel in T.thread_binding(batch_dim * channels, thread="blockIdx.y"):
                for block in T.thread_binding((sequence_dim + T.int64(255)) // T.int64(256), thread="blockIdx.x"):
                    for lane in T.thread_binding(256, thread="threadIdx.x"):
                        position: T.int32 = T.Cast("int32", block * T.int64(256) + T.Cast("int64", lane))
                        if position < T.Cast("int32", sequence_dim):
                            conv: T.float32 = bias[batch_channel % channels]
                            if position >= 3:
                                conv = conv + input[batch_channel // channels, batch_channel % channels, position - 3] * weight[batch_channel % channels, 0]
                            if position >= 2:
                                conv = conv + input[batch_channel // channels, batch_channel % channels, position - 2] * weight[batch_channel % channels, 1]
                            if position >= 1:
                                conv = conv + input[batch_channel // channels, batch_channel % channels, position - 1] * weight[batch_channel % channels, 2]
                            conv = conv + input[batch_channel // channels, batch_channel % channels, position] * weight[batch_channel % channels, 3]
                            conv_bits: T.uint32 = T.reinterpret("uint32", conv)
                            conv_lsb: T.uint32 = conv_bits >> T.uint32(16) & T.uint32(1)
                            conv_bf16: T.float32 = T.reinterpret("float32", conv_bits + T.uint32(32767) + conv_lsb & T.uint32(4294901760))
                            silu: T.float32 = conv_bf16 / (T.float32(1.0) + T.exp(conv_bf16 * T.float32(-1.0)))
                            silu_bits: T.uint32 = T.reinterpret("uint32", silu)
                            silu_lsb: T.uint32 = silu_bits >> T.uint32(16) & T.uint32(1)
                            output[batch_channel // channels, batch_channel % channels, position] = T.reinterpret("float32", silu_bits + T.uint32(32767) + silu_lsb & T.uint32(4294901760))

    @T.prim_func(s_tir=True)
    def qwen35_full_text_gamma_plus_one(width: T.int32, packed: T.Buffer(((width + 1) // 2,), "int32"), output: T.Buffer((width,), "float32")):
        T.func_attr({"tirx.noalias": True})
        with T.sblock("root"):
            T.reads(packed[0:(width + 1) // 2])
            T.writes(output[0:width])
            for block in T.thread_binding((width + 255) // 256, thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    index: T.int32 = T.Cast("int32", block * 256 + lane)
                    if index < width:
                        word: T.uint32 = T.reinterpret("uint32", packed[index // 2])
                        shift: T.uint32 = T.Cast("uint32", index % 2) * T.uint32(16)
                        bf16: T.uint32 = word >> shift & T.uint32(65535)
                        value: T.float32 = T.reinterpret("float32", bf16 << T.uint32(16))
                        output[index] = value + T.float32(1.0)

    @T.prim_func(s_tir=True)
    def qwen35_full_text_gdn_packed_norm(rows: T.int32, width: T.int32, core: T.Buffer((rows, width), "float32"), gate: T.Buffer((rows, width), "float32"), packed_weight: T.Buffer(((width + 1) // 2,), "int32"), output: T.Buffer((rows, width), "float32")):
        T.func_attr({"tirx.noalias": True})
        with T.sblock("root"):
            T.reads(core[0:rows, 0:width], gate[0:rows, 0:width], packed_weight[0:(width + 1) // 2])
            T.writes(output[0:rows, 0:width])
            for row in T.thread_binding(rows, thread="blockIdx.x"):
                square_sum: T.float32 = T.float32(0.0)
                for column in range(width):
                    value: T.float32 = core[row, column]
                    square_sum = square_sum + value * value
                mean_square: T.float32 = square_sum / T.Cast("float32", width)
                inverse_rms: T.float32 = T.rsqrt(mean_square + T.float32(9.9999999999999995e-07))
                for column in range(width):
                    normalized: T.float32 = core[row, column] * inverse_rms
                    normalized_bits: T.uint32 = T.reinterpret("uint32", normalized)
                    normalized_lsb: T.uint32 = normalized_bits >> T.uint32(16) & T.uint32(1)
                    normalized_bf16: T.float32 = T.reinterpret("float32", normalized_bits + T.uint32(32767) + normalized_lsb & T.uint32(4294901760))
                    word: T.uint32 = T.reinterpret("uint32", packed_weight[column // 2])
                    shift: T.uint32 = T.Cast("uint32", column % 2) * T.uint32(16)
                    bf16: T.uint32 = word >> shift & T.uint32(65535)
                    weight: T.float32 = T.reinterpret("float32", bf16 << T.uint32(16))
                    weighted: T.float32 = normalized_bf16 * weight
                    weighted_bits: T.uint32 = T.reinterpret("uint32", weighted)
                    weighted_lsb: T.uint32 = weighted_bits >> T.uint32(16) & T.uint32(1)
                    weighted_bf16: T.float32 = T.reinterpret("float32", weighted_bits + T.uint32(32767) + weighted_lsb & T.uint32(4294901760))
                    gate_value: T.float32 = gate[row, column]
                    silu: T.float32 = gate_value / (T.float32(1.0) + T.exp(gate_value * T.float32(-1.0)))
                    product: T.float32 = weighted_bf16 * silu
                    product_bits: T.uint32 = T.reinterpret("uint32", product)
                    product_lsb: T.uint32 = product_bits >> T.uint32(16) & T.uint32(1)
                    output[row, column] = T.reinterpret("float32", product_bits + T.uint32(32767) + product_lsb & T.uint32(4294901760))

    @T.prim_func(s_tir=True)
    def qwen35_full_text_packed_add_vector(rows: T.int32, width: T.int32, input_buffer: T.Buffer((rows, width), "float32"), packed: T.Buffer(((width + 1) // 2,), "int32"), output: T.Buffer((rows, width), "float32")):
        T.func_attr({"tirx.noalias": True})
        with T.sblock("root"):
            T.reads(input_buffer[0:rows, 0:width], packed[0:(width + 1) // 2])
            T.writes(output[0:rows, 0:width])
            for row in T.thread_binding(rows, thread="blockIdx.y"):
                for block in T.thread_binding((width + 255) // 256, thread="blockIdx.x"):
                    for lane in T.thread_binding(256, thread="threadIdx.x"):
                        column: T.int32 = T.Cast("int32", block * 256 + lane)
                        if column < width:
                            word: T.uint32 = T.reinterpret("uint32", packed[column // 2])
                            shift: T.uint32 = T.Cast("uint32", column % 2) * T.uint32(16)
                            bf16: T.uint32 = word >> shift & T.uint32(65535)
                            value: T.float32 = T.reinterpret("float32", bf16 << T.uint32(16))
                            output[row, column] = input_buffer[row, column] + value

    @T.prim_func(s_tir=True)
    def qwen35_full_text_packed_conv(batch_dim: T.int32, channels: T.int32, sequence_dim: T.int32, input_buffer: T.Buffer((batch_dim, channels, sequence_dim), "float32"), packed_weight: T.Buffer((channels, 2), "int32"), bias: T.Buffer((channels,), "float32"), output: T.Buffer((batch_dim, channels, sequence_dim), "float32")):
        T.func_attr({"tirx.noalias": True})
        with T.sblock("root"):
            T.reads(input_buffer[0:batch_dim, 0:channels, 0:sequence_dim], packed_weight[0:channels, 0:2], bias[0:channels])
            T.writes(output[0:batch_dim, 0:channels, 0:sequence_dim])
            for batch_channel in T.thread_binding(batch_dim * channels, thread="blockIdx.y"):
                for block in T.thread_binding((sequence_dim + 255) // 256, thread="blockIdx.x"):
                    for lane in T.thread_binding(256, thread="threadIdx.x"):
                        position: T.int32 = T.Cast("int32", block * 256 + lane)
                        if position < sequence_dim:
                            batch_index: T.int32 = batch_channel // channels
                            channel: T.int32 = batch_channel % channels
                            conv: T.float32 = bias[channel]
                            for tap in range(4):
                                if position + tap >= 3:
                                    word: T.uint32 = T.reinterpret("uint32", packed_weight[channel, tap // 2])
                                    shift: T.uint32 = T.Cast("uint32", tap % 2) * T.uint32(16)
                                    bf16: T.uint32 = word >> shift & T.uint32(65535)
                                    weight: T.float32 = T.reinterpret("float32", bf16 << T.uint32(16))
                                    conv = conv + input_buffer[batch_index, channel, position + tap - 3] * weight
                            conv_bits: T.uint32 = T.reinterpret("uint32", conv)
                            conv_lsb: T.uint32 = conv_bits >> T.uint32(16) & T.uint32(1)
                            conv_bf16: T.float32 = T.reinterpret("float32", conv_bits + T.uint32(32767) + conv_lsb & T.uint32(4294901760))
                            silu: T.float32 = conv_bf16 / (T.float32(1.0) + T.exp(conv_bf16 * T.float32(-1.0)))
                            silu_bits: T.uint32 = T.reinterpret("uint32", silu)
                            silu_lsb: T.uint32 = silu_bits >> T.uint32(16) & T.uint32(1)
                            output[batch_index, channel, position] = T.reinterpret("float32", silu_bits + T.uint32(32767) + silu_lsb & T.uint32(4294901760))

    @T.prim_func(s_tir=True)
    def qwen35_full_text_packed_exp(width: T.int32, packed: T.Buffer(((width + 1) // 2,), "int32"), output: T.Buffer((width,), "float32")):
        T.func_attr({"tirx.noalias": True})
        with T.sblock("root"):
            T.reads(packed[0:(width + 1) // 2])
            T.writes(output[0:width])
            for block in T.thread_binding((width + 255) // 256, thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    index: T.int32 = T.Cast("int32", block * 256 + lane)
                    if index < width:
                        word: T.uint32 = T.reinterpret("uint32", packed[index // 2])
                        shift: T.uint32 = T.Cast("uint32", index % 2) * T.uint32(16)
                        bf16: T.uint32 = word >> shift & T.uint32(65535)
                        value: T.float32 = T.reinterpret("float32", bf16 << T.uint32(16))
                        output[index] = T.exp(value)

    @T.prim_func(s_tir=True)
    def qwen35_full_text_packed_linear(rows: T.int32, input_features: T.int32, output_features: T.int32, input_buffer: T.Buffer((rows, input_features), "float32"), packed_weight: T.Buffer((output_features, input_features // 2), "int32"), output: T.Buffer((rows, output_features), "float32")):
        T.func_attr({"tirx.noalias": True})
        # with T.sblock("root"):
        for row_loop in T.thread_binding(rows, thread="blockIdx.y"):
            for output_block_loop in T.thread_binding(output_features // 8, thread="blockIdx.x"):
                for output_lane_loop in T.thread_binding(8, thread="threadIdx.y"):
                    for reduction_lane_loop in T.thread_binding(32, thread="threadIdx.x"):
                        with T.sblock("qwen35_packed_bf16_linear_tiled_lane"):
                            row, output_lane = T.axis.remap("SS", [row_loop, output_lane_loop])
                            output_feature = T.axis.spatial(output_features, output_block_loop * 8 + output_lane_loop)
                            reduction_lane = T.axis.spatial(32, reduction_lane_loop)
                            shared_input = T.sblock_alloc_buffer((2048,), scope="shared")
                            partials = T.sblock_alloc_buffer((8, 32), scope="shared")
                            T.reads(input_buffer[row, 0:input_features], packed_weight[output_feature, 0:input_features // 2], shared_input[0:2048], partials[output_lane, 0:32])
                            T.writes(shared_input[0:2048], partials[output_lane, 0:32], output[row, output_feature])
                            accumulator = T.alloc_local((1,))
                            accumulator[0] = T.float32(0.0)
                            for input_tile in range(input_features // 2048):
                                input_tile_offset: T.int32 = input_tile * 2048
                                for activation_group in range(8):
                                    activation_index: T.int32 = activation_group * 8 * 32 + output_lane * 32 + reduction_lane
                                    shared_input[activation_index] = input_buffer[row, input_tile_offset + activation_index]
                                T.tvm_storage_sync("shared", T.bool(False), -1)
                                for word_group in range(32):
                                    packed_index_in_tile: T.int32 = word_group * 32 + reduction_lane
                                    packed_index: T.int32 = input_tile * 1024 + packed_index_in_tile
                                    word: T.uint32 = T.reinterpret("uint32", packed_weight[output_feature, packed_index])
                                    low_bits: T.uint32 = word & T.uint32(65535)
                                    high_bits: T.uint32 = word >> T.uint32(16) & T.uint32(65535)
                                    low_weight: T.float32 = T.reinterpret("float32", low_bits << T.uint32(16))
                                    high_weight: T.float32 = T.reinterpret("float32", high_bits << T.uint32(16))
                                    activation_index: T.int32 = packed_index_in_tile * 2
                                    accumulator[0] = accumulator[0] + shared_input[activation_index] * low_weight + shared_input[activation_index + 1] * high_weight
                                T.tvm_storage_sync("shared", T.bool(False), -1)
                            partials[output_lane, reduction_lane] = accumulator[0]
                            T.tvm_storage_sync("shared", T.bool(False), -1)
                            for reduction_stage in range(5):
                                stride: T.int32 = 32 >> reduction_stage + 1
                                if reduction_lane < stride:
                                    partials[output_lane, reduction_lane] = partials[output_lane, reduction_lane] + partials[output_lane, reduction_lane + stride]
                                T.tvm_storage_sync("shared", T.bool(False), -1)
                            if reduction_lane == 0:
                                result: T.float32 = partials[output_lane, 0]
                                result_bits: T.uint32 = T.reinterpret("uint32", result)
                                low_bit: T.uint32 = result_bits >> T.uint32(16) & T.uint32(1)
                                is_nan: T.bool = result_bits & T.uint32(2139095040) == T.uint32(2139095040) and result_bits & T.uint32(8388607) != T.uint32(0)
                                rounded_bits: T.uint32 = T.if_then_else(is_nan, T.uint32(2143289344), result_bits + T.uint32(32767) + low_bit & T.uint32(4294901760))
                                output[row, output_feature] = T.reinterpret("float32", rounded_bits)

    @T.prim_func(s_tir=True)
    def qwen35_gated_rmsnorm_bf16_boundaries(core: T.Buffer((rows, width), "float32"), gate: T.Buffer((rows, width), "float32"), weight: T.Buffer((width,), "float32"), output: T.Buffer((rows, width), "float32")):
        T.func_attr({"global_symbol": "gated_rmsnorm", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for row in T.thread_binding(rows, thread="blockIdx.x"):
                square_sum: T.float32 = T.float32(0.0)
                for column in range(width):
                    value: T.float32 = core[row, column]
                    square_sum = square_sum + value * value
                mean_square: T.float32 = square_sum / T.Cast("float32", width)
                inverse_rms: T.float32 = T.rsqrt(mean_square + T.float32(9.9999999999999995e-07))
                for column in range(width):
                    normalized: T.float32 = core[row, column] * inverse_rms
                    normalized_bits: T.uint32 = T.reinterpret("uint32", normalized)
                    normalized_lsb: T.uint32 = normalized_bits >> T.uint32(16) & T.uint32(1)
                    normalized_bf16: T.float32 = T.reinterpret("float32", normalized_bits + T.uint32(32767) + normalized_lsb & T.uint32(4294901760))
                    weighted: T.float32 = normalized_bf16 * weight[column]
                    weighted_bits: T.uint32 = T.reinterpret("uint32", weighted)
                    weighted_lsb: T.uint32 = weighted_bits >> T.uint32(16) & T.uint32(1)
                    weighted_bf16: T.float32 = T.reinterpret("float32", weighted_bits + T.uint32(32767) + weighted_lsb & T.uint32(4294901760))
                    gate_value: T.float32 = gate[row, column]
                    silu: T.float32 = gate_value / (T.float32(1.0) + T.exp(gate_value * T.float32(-1.0)))
                    product: T.float32 = weighted_bf16 * silu
                    product_bits: T.uint32 = T.reinterpret("uint32", product)
                    product_lsb: T.uint32 = product_bits >> T.uint32(16) & T.uint32(1)
                    output[row, column] = T.reinterpret("float32", product_bits + T.uint32(32767) + product_lsb & T.uint32(4294901760))

    @T.prim_func(s_tir=True)
    def qwen35_gdn_chunkify_beta(beta: T.Buffer((batch_dim, sequence_dim, 16), "float32"), beta_chunk: T.Buffer((batch_dim, 16, '(sequence_dim + T.int64(64) - T.int64(1)) // T.int64(64)', 64), "float32")):
        T.func_attr({"global_symbol": "chunkify_beta", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_head in T.thread_binding(batch_dim * T.int64(16), thread="blockIdx.y"):
                for chunk_index in T.thread_binding((sequence_dim + T.int64(63)) // T.int64(64), thread="blockIdx.x"):
                    for row in range(64):
                        position: T.int32 = T.Cast("int32", chunk_index * T.int64(64) + T.Cast("int64", row))
                        for lane in T.thread_binding(128, thread="threadIdx.x"):
                            if lane == 0:
                                if position < T.Cast("int32", sequence_dim):
                                    beta_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row] = beta[batch_head // T.int64(16), position, batch_head % T.int64(16)]
                                else:
                                    beta_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row] = T.float32(0.0)

    @T.prim_func(s_tir=True)
    def qwen35_gdn_chunkify_qkv_decay(query: T.Buffer((batch_dim, sequence_dim, 16, 128), "float32"), key: T.Buffer((batch_dim, sequence_dim, 16, 128), "float32"), value: T.Buffer((batch_dim, sequence_dim, 16, 128), "float32"), decay: T.Buffer((batch_dim, sequence_dim, 16), "float32"), query_chunk: T.Buffer((batch_dim, 16, '(sequence_dim + T.int64(64) - T.int64(1)) // T.int64(64)', 64, 128), "float32"), key_chunk: T.Buffer((batch_dim, 16, '(sequence_dim + T.int64(64) - T.int64(1)) // T.int64(64)', 64, 128), "float32"), value_chunk: T.Buffer((batch_dim, 16, '(sequence_dim + T.int64(64) - T.int64(1)) // T.int64(64)', 64, 128), "float32"), decay_chunk: T.Buffer((batch_dim, 16, '(sequence_dim + T.int64(64) - T.int64(1)) // T.int64(64)', 64), "float32")):
        T.func_attr({"global_symbol": "chunkify_qkv_decay", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_head in T.thread_binding(batch_dim * T.int64(16), thread="blockIdx.y"):
                for chunk_index in T.thread_binding((sequence_dim + T.int64(63)) // T.int64(64), thread="blockIdx.x"):
                    for row in range(64):
                        position: T.int32 = T.Cast("int32", chunk_index * T.int64(64) + T.Cast("int64", row))
                        if position < T.Cast("int32", sequence_dim):
                            for dim in T.thread_binding(128, thread="threadIdx.x"):
                                query_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = query[batch_head // T.int64(16), position, batch_head % T.int64(16), dim]
                                key_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = key[batch_head // T.int64(16), position, batch_head % T.int64(16), dim]
                            for dim in T.thread_binding(128, thread="threadIdx.x"):
                                value_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = value[batch_head // T.int64(16), position, batch_head % T.int64(16), dim]
                            for lane in T.thread_binding(128, thread="threadIdx.x"):
                                if lane == 0:
                                    decay_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row] = decay[batch_head // T.int64(16), position, batch_head % T.int64(16)]
                        else:
                            for dim in T.thread_binding(128, thread="threadIdx.x"):
                                query_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = T.float32(0.0)
                                key_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = T.float32(0.0)
                            for dim in T.thread_binding(128, thread="threadIdx.x"):
                                value_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, dim] = T.float32(0.0)
                            for lane in T.thread_binding(128, thread="threadIdx.x"):
                                if lane == 0:
                                    decay_chunk[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row] = T.float32(0.0)

    @T.prim_func(s_tir=True)
    def qwen35_gdn_dynamic_chunk_scan(query: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), key: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), new_values: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), cumulative_keys: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), intra: T.Buffer((batch_dim, 16, chunks, 64, 64), "float32"), chunk_decay: T.Buffer((batch_dim, 16, chunks), "float32"), output: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), state: T.Buffer((batch_dim, 16, 2, 128, 128), "float32")):
        T.func_attr({"global_symbol": "scan", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_head in T.thread_binding(batch_dim * T.int64(16), thread="blockIdx.y"):
                for value_index in T.thread_binding(128, thread="threadIdx.x"):
                    for key_index in range(128):
                        state[batch_head // T.int64(16), batch_head % T.int64(16), 0, key_index, value_index] = T.float32(0.0)
                    for chunk_index in range(chunks):
                        for row in range(64):
                            correction: T.float32 = T.float32(0.0)
                            for key_index in range(128):
                                correction = correction + cumulative_keys[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, key_index] * state[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index % T.int64(2), key_index, value_index]
                            output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index] = new_values[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index] - correction
                        for key_index in range(128):
                            next_state: T.float32 = state[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index % T.int64(2), key_index, value_index] * chunk_decay[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index]
                            for row in range(64):
                                next_state = next_state + key[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, key_index] * output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index]
                            state[batch_head // T.int64(16), batch_head % T.int64(16), T.int64(1) - chunk_index % T.int64(2), key_index, value_index] = next_state
                        for reverse_row in range(64):
                            row: T.int32 = 63 - reverse_row
                            inter: T.float32 = T.float32(0.0)
                            for key_index in range(128):
                                inter = inter + query[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, key_index] * state[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index % T.int64(2), key_index, value_index]
                            within_chunk: T.float32 = T.float32(0.0)
                            for source_row in range(row + 1):
                                within_chunk = within_chunk + intra[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, source_row] * output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, source_row, value_index]
                            output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index] = inter + within_chunk

    @T.prim_func(s_tir=True)
    def qwen35_gdn_triangular_masked_exp(input_buffer: T.Buffer((batch_dim, 16, chunks, 64, 64), "float32"), output_buffer: T.Buffer((batch_dim, 16, chunks, 64, 64), "float32")):
        T.func_attr({"global_symbol": "masked_exp", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_head_chunk in T.thread_binding(batch_dim * chunks * T.int64(16), thread="blockIdx.y"):
                chunks_i32: T.int32 = T.Cast("int32", chunks)
                group_i32: T.int32 = T.Cast("int32", batch_head_chunk)
                batch_index: T.int32 = group_i32 // (16 * chunks_i32)
                head_index: T.int32 = group_i32 // chunks_i32 % 16
                chunk_index: T.int32 = group_i32 % chunks_i32
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    for tile in range(16):
                        element: T.int32 = tile * 256 + lane
                        row: T.int32 = element // 64
                        column: T.int32 = element % 64
                        if row < column:
                            output_buffer[batch_index, head_index, chunk_index, row, column] = T.float32(0.0)
                        else:
                            output_buffer[batch_index, head_index, chunk_index, row, column] = T.exp(input_buffer[batch_index, head_index, chunk_index, row, column])

    @T.prim_func(s_tir=True)
    def qwen35_gdn_triangular_solve(system: T.Buffer((batch_dim, 16, chunks, 64, 64), "float32"), value_rhs: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), key_rhs: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), value_output: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), key_output: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32")):
        T.func_attr({"global_symbol": "solve", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads()
            T.writes()
            for batch_head in T.thread_binding(batch_dim * T.int64(16), thread="blockIdx.y"):
                for chunk_index in T.thread_binding(chunks, thread="blockIdx.x"):
                    for row in range(64):
                        for value_index in T.thread_binding(128, thread="threadIdx.x"):
                            solved_value: T.float32 = value_rhs[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index]
                            for previous_row in range(row):
                                solved_value = solved_value - system[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, previous_row] * value_output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, previous_row, value_index]
                            value_output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, value_index] = solved_value
                        for key_index in T.thread_binding(128, thread="threadIdx.x"):
                            solved_key: T.float32 = key_rhs[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, key_index]
                            for previous_row in range(row):
                                solved_key = solved_key - system[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, previous_row] * key_output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, previous_row, key_index]
                            key_output[batch_head // T.int64(16), batch_head % T.int64(16), chunk_index, row, key_index] = solved_key

    @T.prim_func(s_tir=True)
    def qwen35_gdn_unpack(core: T.Buffer((batch_dim, 16, chunks, 64, 128), "float32"), query: T.Buffer((batch_dim, sequence_dim, 16, 128), "float32"), output: T.Buffer((batch_dim, sequence_dim, 16, 128), "float32")):
        T.func_attr({"global_symbol": "gdn_unpack", "tirx.noalias": True})
        with T.sblock("root"):
            T.reads(query[0, 0, 0, 0])
            T.writes(output[0, 0, 0, 0])
            for block in T.thread_binding(batch_dim * sequence_dim * T.int64(8), thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    index: T.int32 = T.Cast("int32", block * T.int64(256) + T.Cast("int64", lane))
                    if index < T.Cast("int32", batch_dim * sequence_dim * T.int64(16) * T.int64(128)):
                        value_index: T.int32 = index % 128
                        head_index: T.int32 = index // 128 % 16
                        position: T.int32 = index // 2048 % T.Cast("int32", sequence_dim)
                        batch_index: T.int32 = index // T.Cast("int32", sequence_dim * T.int64(16) * T.int64(128))
                        chunk_index: T.int32 = position // 64
                        row: T.int32 = position % 64
                        value: T.float32 = core[batch_index, head_index, chunk_index, row, value_index]
                        bits: T.uint32 = T.reinterpret("uint32", value)
                        low_bit: T.uint32 = bits >> T.uint32(16) & T.uint32(1)
                        rounded: T.uint32 = bits + T.uint32(32767) + low_bit & T.uint32(4294901760)
                        output[batch_index, position, head_index, value_index] = T.reinterpret("float32", rounded)

    @T.prim_func(s_tir=True)
    def qwen35_padded_hidden_int32_mask_gate(mask: T.Buffer((batch_dim, sequence_dim), "int32"), hidden: T.Buffer((batch_dim, sequence_dim, 2048), "float32"), output: T.Buffer((batch_dim, sequence_dim, 2048), "float32")):
        T.func_attr({"global_symbol": "apply", "tirx.is_scheduled": True, "tirx.noalias": True})
        with T.sblock("root"):
            T.reads(mask[0:batch_dim, 0:sequence_dim], hidden[0:batch_dim, 0:sequence_dim, 0:2048])
            T.writes(output[0:batch_dim, 0:sequence_dim, 0:2048])
            for batch_index in T.thread_binding(batch_dim, thread="blockIdx.y"):
                for block in T.thread_binding(sequence_dim * T.int64(8), thread="blockIdx.x"):
                    block_index: T.int32 = T.Cast("int32", block)
                    sequence_index: T.int32 = block_index // 8
                    width_block: T.int32 = block_index % 8
                    for lane in T.thread_binding(256, thread="threadIdx.x"):
                        width_index: T.int32 = width_block * 256 + lane
                        if width_index < 2048:
                            mask_value: T.float32 = T.Cast("float32", mask[batch_index, sequence_index] != 0)
                            output[batch_index, sequence_index, width_index] = hidden[batch_index, sequence_index, width_index] * mask_value

    @T.prim_func(s_tir=True)
    def qwen35_pointer_online_sdpa_int32_padding(query: T.Buffer(("batch_size", "sequence", 8, 256), "float32"), key: T.Buffer((batch_size, 'sequence', 8, 256), "float32"), value: T.Buffer((batch_size, 'sequence', 8, 256), "float32"), padding: T.Buffer((batch_size, 'sequence'), "int32"), output: T.Buffer((batch_size, 'sequence', 8, 256), "float32")):
        batch_size, sequence = T.int32(), T.int32()
        T.func_attr({"global_symbol": "attention", "tirx.is_scheduled": True, "tirx.noalias": True})
        # with T.sblock("root"):
        row_count: T.let[T.int32] = batch_size * sequence
        row_tile_width: T.let[T.int32] = T.min(row_count, 32768)
        row_tile_count: T.let[T.int32] = (row_count + 32768 - 1) // 32768
        for row_offset in T.thread_binding(row_tile_width, thread="blockIdx.x"):
            for row_tile_head in T.thread_binding(row_tile_count * 8, thread="blockIdx.y"):
                row_tile: T.let[T.int32] = row_tile_head // 8
                head_index: T.let[T.int32] = row_tile_head % 8
                row_index: T.let[T.int32] = row_tile * row_tile_width + row_offset
                with T.sblock("qwen35_text_sdpa_online_row"):
                    batch = T.axis.spatial(batch_size, row_index // sequence)
                    query_index = T.axis.spatial(sequence, row_index % sequence)
                    head = T.axis.spatial(8, head_index)
                    T.where(row_index < row_count)
                    T.reads(query[batch, query_index, head, 0:256], key[batch, 0:sequence, head, 0:256], value[batch, 0:sequence, head, 0:256], padding[batch, 0:sequence])
                    T.writes(output[batch, query_index, head, 0:256])
                    maximum = T.alloc_local((1,))
                    denominator = T.alloc_local((1,))
                    dot = T.alloc_local((1,))
                    rounded = T.alloc_local((1,))
                    new_scale = T.alloc_local((1,))
                    accumulator = T.alloc_local((256,))
                    has_key = T.alloc_local((1,), "int32")
                    maximum[0] = T.float32(-340282346638528859811704183484516925440.0)
                    denominator[0] = T.float32(0.0)
                    has_key[0] = 0
                    for dim in range(256):
                        accumulator[dim] = T.float32(0.0)
                    for key_index in range(sequence):
                        allowed: T.let[T.bool] = (key_index <= query_index) & (padding[batch, key_index] != 0)
                        if allowed:
                            dot[0] = T.float32(0.0)
                            for dim in range(256):
                                dot[0] = dot[0] + query[batch, query_index, head, dim] * key[batch, key_index, head, dim]
                            score: T.let[T.float32] = dot[0] * T.float32(0.0625)
                            if has_key[0] == 0:
                                maximum[0] = score
                                denominator[0] = T.float32(1.0)
                                for dim in range(256):
                                    accumulator[dim] = value[batch, key_index, head, dim]
                                has_key[0] = 1
                            else:
                                next_maximum: T.let[T.float32] = T.max(maximum[0], score)
                                old_scale: T.let[T.float32] = T.exp(maximum[0] - next_maximum)
                                new_scale[0] = T.exp(score - next_maximum)
                                denominator[0] = denominator[0] * old_scale + new_scale[0]
                                for dim in range(256):
                                    accumulator[dim] = accumulator[dim] * old_scale + new_scale[0] * value[batch, key_index, head, dim]
                                maximum[0] = next_maximum
                    if has_key[0] != 0:
                        for dim in range(256):
                            normalized: T.let[T.float32] = accumulator[dim] / denominator[0]
                            bits: T.let[T.uint32] = T.reinterpret("uint32", normalized)
                            is_nan: T.let[T.bool] = (bits & T.uint32(2139095040) == T.uint32(2139095040)) & (bits & T.uint32(8388607) != T.uint32(0))
                            rounded_1: T.let[T.uint32] = bits + T.uint32(32767) + (bits >> T.uint32(16) & T.uint32(1)) & T.uint32(4294901760)
                            quiet_nan: T.let[T.uint32] = bits & T.uint32(4294901760) | T.uint32(4194304)
                            rounded[0] = T.reinterpret("float32", T.if_then_else(is_nan, quiet_nan, rounded_1))
                            output[batch, query_index, head, dim] = rounded[0]
                    else:
                        for dim in range(256):
                            output[batch, query_index, head, dim] = T.float32(0.0)

    @T.prim_func(s_tir=True)
    def qwen35_pointer_option_logits_masked_fill_int32(fill_value: T.float32, n_slots: T.Buffer((batch_dim,), "int32"), logits: T.Buffer((batch_dim, options), "float32"), output: T.Buffer((batch_dim, options), "float32")):
        T.func_attr({"global_symbol": "option_logits_masked_fill", "tirx.noalias": True})
        # with T.sblock("root"):
        for batch_loop in T.thread_binding(batch_dim, thread="blockIdx.y"):
            for option_loop in T.thread_binding(options, thread="blockIdx.x"):
                with T.sblock("qwen35_option_logits_masked_fill"):
                    batch_index, option_index = T.axis.remap("SS", [batch_loop, option_loop])
                    T.reads(n_slots[batch_index], logits[batch_index, option_index])
                    T.writes(output[batch_index, option_index])
                    valid: T.bool = T.Cast("int32", option_index) < n_slots[batch_index]
                    output[batch_index, option_index] = T.if_then_else(valid, logits[batch_index, option_index], fill_value)

    @T.prim_func(s_tir=True)
    def qwen35_temperature_clamp_preserve_nan(input_buffer: T.Buffer((rows,), "float32"), output_buffer: T.Buffer((rows,), "float32")):
        T.func_attr({"global_symbol": "clamp_min_preserve_nan", "tirx.is_scheduled": True, "tirx.noalias": True})
        # with T.sblock("root"):
        minimum: T.float32 = T.float32(9.9999999999999995e-07)
        with T.sblock("root"):
            T.reads(input_buffer[0:rows])
            T.writes(output_buffer[0:rows])
            for block in T.thread_binding((rows + T.int64(255)) // T.int64(256), thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    row: T.int32 = T.Cast("int32", block * T.int64(256) + T.Cast("int64", lane))
                    if row < T.Cast("int32", rows):
                        value: T.float32 = input_buffer[row]
                        clamped: T.float32 = T.if_then_else(value < minimum, minimum, value)
                        output_buffer[row] = T.if_then_else(value != value, value, clamped)

    @T.prim_func(s_tir=True)
    def qwen35_text_bf16_rne_fp32(x: T.Buffer((size,), "float32"), y: T.Buffer((size,), "float32")):
        T.func_attr({"global_symbol": "round_bf16", "tirx.noalias": True})
        # with T.sblock("root"):
        for group_y in T.thread_binding(((size + T.int64(255)) // T.int64(256) + T.min((size + T.int64(255)) // T.int64(256), T.int64(256)) - T.int64(1)) // T.min((size + T.int64(255)) // T.int64(256), T.int64(256)), thread="blockIdx.y"):
            for group_x in T.thread_binding(T.min((size + T.int64(255)) // T.int64(256), T.int64(256)), thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    index: T.int32 = T.Cast("int32", (group_y * T.min((size + T.int64(256) - T.int64(1)) // T.int64(256), T.int64(256)) + group_x) * T.int64(256) + T.Cast("int64", lane))
                    if index < T.Cast("int32", size):
                        with T.sblock("bf16_round_rne"):
                            i = T.axis.spatial(size, index)
                            T.reads(x[i])
                            T.writes(y[i])
                            bits: T.uint32 = T.reinterpret("uint32", x[i])
                            low_bit: T.uint32 = bits >> T.uint32(16) & T.uint32(1)
                            rounded: T.uint32 = bits + T.uint32(32767) + low_bit & T.uint32(4294901760)
                            y[i] = T.reinterpret("float32", rounded)

