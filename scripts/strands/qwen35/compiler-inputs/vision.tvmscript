s34 = TypeVar("s34")
@I.ir_module
class Module:
    @T.prim_func(s_tir=True)
    def qwen35_vision_webgpu_bf16_rne_f32(sequence: T.int32, input_buffer: T.Buffer((sequence,), "float32"), output_buffer: T.Buffer((sequence,), "float32")):
        T.func_attr({"global_symbol": "round_bf16_webgpu", "tirx.noalias": True})
        # with T.sblock("root"):
        for group_y in T.thread_binding(((sequence + 255) // 256 + T.min((sequence + 255) // 256, 256) - 1) // T.min((sequence + 255) // 256, 256), thread="blockIdx.y"):
            for group_x in T.thread_binding(T.min((sequence + 255) // 256, 256), thread="blockIdx.x"):
                for lane in T.thread_binding(256, thread="threadIdx.x"):
                    with T.sblock("qwen35_bf16_round_webgpu_element"):
                        value_index = T.axis.spatial(sequence, T.Cast("int32", (group_y * T.min((sequence + 256 - 1) // 256, 256) + group_x) * 256 + lane))
                        T.reads(input_buffer[value_index])
                        T.writes(output_buffer[value_index])
                        if value_index < sequence:
                            bits: T.uint32 = T.reinterpret("uint32", input_buffer[value_index])
                            low_bit: T.uint32 = bits >> T.uint32(16) & T.uint32(1)
                            is_nan: T.bool = bits & T.uint32(2139095040) == T.uint32(2139095040) and bits & T.uint32(8388607) != T.uint32(0)
                            rounded: T.uint32 = T.if_then_else(is_nan, T.uint32(2143289344), bits + T.uint32(32767) + low_bit & T.uint32(4294901760))
                            output_buffer[value_index] = T.reinterpret("float32", rounded)

    @T.prim_func(s_tir=True)
    def qwen35_vision_webgpu_single_segment_attention(sequence: T.int32, query: T.Buffer((sequence, 16, 64), "float32"), key: T.Buffer((sequence, 16, 64), "float32"), value: T.Buffer((sequence, 16, 64), "float32"), output: T.Buffer((sequence, 16, 64), "float32")):
        T.func_attr({"global_symbol": "attention_single_segment", "tirx.noalias": True})
        # with T.sblock("root"):
        query_tile_count: T.let[T.int32] = (sequence + 32768 - 1) // 32768
        query_tile_width: T.let[T.int32] = T.min(sequence, 32768)
        with T.sblock("qwen35_vision_single_attention_root"):
            T.reads(query[0:query_tile_count * 32768 + query_tile_width - 32768, 0:16, 0:64], key[0:sequence, 0:16, 0:64], value[0:sequence, 0:16, 0:64])
            T.writes(output[0:query_tile_count * 32768 + query_tile_width - 32768, 0:16, 0:64])
            for query_offset in T.thread_binding(query_tile_width, thread="blockIdx.x"):
                for query_tile_head in T.thread_binding(query_tile_count * 16, thread="blockIdx.y"):
                    for output_dim in T.thread_binding(64, thread="threadIdx.x"):
                        with T.sblock("qwen35_vision_single_attention_lane"):
                            qrow = T.axis.spatial(sequence, query_tile_head // 16 * 32768 + query_offset)
                            head_index = T.axis.spatial(16, query_tile_head % 16)
                            out_dim = T.axis.spatial(64, output_dim)
                            T.where(query_tile_head // 16 * 32768 + query_offset < sequence)
                            T.reads(query[qrow, head_index, 0:64], key[0:sequence, head_index, 0:64], value[0:sequence, head_index, out_dim])
                            T.writes(output[qrow, head_index, out_dim])
                            maximum = T.alloc_local((1,))
                            denominator = T.alloc_local((1,))
                            dot = T.alloc_local((1,))
                            accumulator = T.alloc_local((1,))
                            maximum[0] = T.float32(-340282346638528859811704183484516925440.0)
                            denominator[0] = T.float32(0.0)
                            accumulator[0] = T.float32(0.0)
                            for key_index in range(sequence):
                                dot[0] = T.float32(0.0)
                                for dim in range(64):
                                    dot[0] = dot[0] + query[qrow, head_index, dim] * key[key_index, head_index, dim]
                                score: T.float32 = dot[0] * T.float32(0.125)
                                next_maximum: T.float32 = T.max(maximum[0], score)
                                old_scale: T.float32 = T.exp(maximum[0] - next_maximum)
                                new_scale: T.float32 = T.exp(score - next_maximum)
                                denominator[0] = denominator[0] * old_scale + new_scale
                                accumulator[0] = accumulator[0] * old_scale + new_scale * value[key_index, head_index, out_dim]
                                maximum[0] = next_maximum
                            output[qrow, head_index, out_dim] = accumulator[0] / denominator[0]

